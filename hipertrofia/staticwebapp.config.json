{
  "platform": { "apiRuntime": "node:20" },
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/login", "rewrite": "/.auth/login/github?post_login_redirect_uri=/" },
    { "route": "/api/polar-webhook", "allowedRoles": ["anonymous"] },
    { "route": "/api/polar-callback", "allowedRoles": ["anonymous"] },
    { "route": "/manifest.webmanifest", "allowedRoles": ["anonymous"] },
    { "route": "/sw.js", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-cache" } },
    { "route": "/icons/*", "allowedRoles": ["anonymous"] },
    { "route": "/*", "allowedRoles": ["dono"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/github?post_login_redirect_uri=/", "statusCode": 302 },
    "403": { "rewrite": "/sem-acesso.html", "statusCode": 403 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  }
}
